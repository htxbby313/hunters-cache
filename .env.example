NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/hunters-cache.db
# Production uses Neon PostgreSQL. Leave blank only for local SQLite development.
DATABASE_URL=
JWT_SECRET=replace-with-at-least-32-random-characters

# GunTab marketplace API. Start with a test key, then replace it with a live key.
# The Hunter's Cache GunTab account must have a verified email and bank account.
GUNTAB_API_TOKEN=
GUNTAB_API_BASE_URL=https://api.guntab.com/v1
GUNTAB_WEBHOOK_SECRET=

# Confirmed production domain. Keep Google Workspace MX/TXT records intact when connecting hosting.
PUBLIC_APP_URL=https://hunterscacheusa.com

# Required before firearm checkout. Obtain from fflapi.com.
FFL_API_KEY=
ENABLE_FIREARM_CHECKOUT=false

# Protects the researched comparable-sale import endpoint.
MARKET_DATA_ADMIN_KEY=replace-with-a-separate-random-secret

# Protects moderation, verification, disputes, and business analytics endpoints.
OPERATIONS_ADMIN_KEY=replace-with-another-long-random-secret
